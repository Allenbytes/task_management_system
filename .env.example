# Copy this file to .env and fill in the values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# CORE API (study resource recommendations) - free key: https://core.ac.uk/services/api
CORE_API_KEY=

# Google OAuth client (Gmail + Calendar) - Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/oauth/callback/

# Time zone for exam events (IANA name)
CALENDAR_TIME_ZONE=Asia/Manila
